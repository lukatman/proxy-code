#!/usr/bin/env bash

set -u

library=@PROXYCODE_LIBRARY@
if [[ ! -r $library ]]; then
  printf 'proxycode: installed library is missing; rerun the installer\n' >&2
  exit 1
fi
# shellcheck source=../lib/proxycode.sh
source "$library"

choose_profile() {
  local prompt=$1
  local -a profiles
  mapfile -t profiles < <(proxycode_profile_list)
  ((${#profiles[@]})) || { proxycode_error 'no Tunnel Profiles are configured'; return 2; }
  proxycode_choose "$prompt" "${profiles[@]}" || return
  PROXYCODE_SELECTED_PROFILE=${profiles[PROXYCODE_CHOICE - 1]}
}

interactive_import() {
  local source_file name make_default=false replace=false profile
  proxycode_prompt 'WireGuard configuration file' || return 2
  source_file=$PROXYCODE_ANSWER
  proxycode_prompt 'Tunnel Profile name' "$(proxycode_suggest_profile_name "$source_file")" || return 2
  name=$PROXYCODE_ANSWER
  proxycode_choose "Make '$name' the Default Tunnel Profile?" 'Yes' 'No' || return 2
  [[ $PROXYCODE_CHOICE == 1 ]] && make_default=true
  proxycode_init_paths || return
  profile=$(proxycode_profile_path "$name" 2>/dev/null) || { proxycode_error "invalid Tunnel Profile name '$name'" 2; return; }
  [[ -d $profile ]] && replace=true
  proxycode_with_lifecycle_lock proxycode_profile_import "$source_file" "$name" "$make_default" "$replace" false
}

interactive_settings() {
  local port probe expectation url status contains
  expectation=
  url=
  status=
  contains=
  proxycode_choose 'Settings' 'HTTP listener port' 'Tunnel Profile health probe' 'Back' || return 2
  case $PROXYCODE_CHOICE in
    1)
      proxycode_load_global_settings || return
      proxycode_prompt 'HTTP listener port' "$PROXYCODE_HTTP_PORT" || return 2
      port=$PROXYCODE_ANSWER
      proxycode_with_lifecycle_lock proxycode_settings_update "$port"
      ;;
    2)
      choose_profile 'Choose a Tunnel Profile' || return
      proxycode_choose 'Health probe' 'Cloudflare' 'Mullvad' 'Custom HTTPS URL' || return 2
      case $PROXYCODE_CHOICE in
        1) probe=cloudflare; proxycode_prompt 'Expected country code, or blank for any' || return 2; expectation=$PROXYCODE_ANSWER ;;
        2) probe=mullvad; proxycode_prompt 'Expected location, or blank for any' || return 2; expectation=$PROXYCODE_ANSWER ;;
        3)
          probe=custom
          proxycode_prompt 'HTTPS probe URL' || return 2; url=$PROXYCODE_ANSWER
          proxycode_prompt 'Expected HTTP status' 200 || return 2; status=$PROXYCODE_ANSWER
          proxycode_prompt 'Required response text, or blank for any' || return 2; contains=$PROXYCODE_ANSWER
          ;;
      esac
      proxycode_profile_settings_update "$PROXYCODE_SELECTED_PROFILE" "$probe" "$expectation" "$url" "$status" "$contains"
      ;;
  esac
}

interactive_management() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    proxycode_help >&2
    return 2
  fi
  while :; do
    printf '◆ ProxyCode  management\n\n'
    proxycode_with_lifecycle_lock proxycode_status_locked || true
    printf '\n'
    proxycode_choose 'Choose an action' \
      'Import a Tunnel Profile' \
      'Select the Default Profile' \
      'Start a Profile' \
      'Stop the Active Profile' \
      'Switch Active Profile' \
      'Remove a Profile' \
      'Status and health check' \
      'Settings' \
      'Exit' || return 2
    printf '\n'
    case $PROXYCODE_CHOICE in
      1) interactive_import ;;
      2) choose_profile 'Choose the Default Tunnel Profile' && proxycode_profile_default "$PROXYCODE_SELECTED_PROFILE" ;;
      3) choose_profile 'Choose a Tunnel Profile to start' && proxycode_with_lifecycle_lock proxycode_start_locked "$PROXYCODE_SELECTED_PROFILE" ;;
      4) proxycode_with_lifecycle_lock proxycode_stop_locked ;;
      5) choose_profile 'Choose a Tunnel Profile to switch to' && proxycode_with_lifecycle_lock proxycode_switch_locked "$PROXYCODE_SELECTED_PROFILE" false ;;
      6) choose_profile 'Choose a Tunnel Profile to remove' && proxycode_with_lifecycle_lock proxycode_profile_remove "$PROXYCODE_SELECTED_PROFILE" false ;;
      7)
        proxycode_choose 'Status or health check?' 'Show local status' 'Check the Active Tunnel Profile' 'Back' || return 2
        [[ $PROXYCODE_CHOICE == 1 ]] && proxycode_with_lifecycle_lock proxycode_status_locked
        [[ $PROXYCODE_CHOICE == 2 ]] && proxycode_with_lifecycle_lock proxycode_check_locked
        ;;
      8) interactive_settings ;;
      9) return 0 ;;
    esac
    printf '\n'
  done
}

selected_profile=
if [[ ${1:-} == --profile ]]; then
  (($# >= 3)) || { printf 'Usage: proxycode --profile NAME COMMAND [ARG...]\n' >&2; exit 2; }
  selected_profile=$2
  proxycode_validate_profile_name "$selected_profile" || { printf "proxycode: invalid Tunnel Profile name '%s'\n" "$selected_profile" >&2; exit 2; }
  shift 2
fi
case ${1:-} in
  help|--help|version|--version|status|check|start|stop|switch|profile|settings|upgrade)
    [[ -z $selected_profile ]] || { printf 'proxycode: --profile is only valid with a Wrapped command\n' >&2; exit 2; }
    ;;
esac

case ${1:-} in
  help|--help)
    (($# == 1)) || { printf 'proxycode help: unexpected arguments\n' >&2; exit 2; }
    proxycode_help
    ;;
  version|--version)
    (($# == 1)) || { printf 'proxycode version: unexpected arguments\n' >&2; exit 2; }
    printf 'proxycode %s\n' "$PROXYCODE_VERSION"
    ;;
  start)
    (($# <= 2)) || { printf 'Usage: proxycode start [NAME]\n' >&2; exit 2; }
    proxycode_with_lifecycle_lock proxycode_start_locked "${2:-}"
    ;;
  stop)
    (($# == 1)) || { printf 'Usage: proxycode stop\n' >&2; exit 2; }
    proxycode_with_lifecycle_lock proxycode_stop_locked
    ;;
  status)
    (($# == 1)) || { printf 'Usage: proxycode status\n' >&2; exit 2; }
    proxycode_with_lifecycle_lock proxycode_status_locked
    ;;
  check)
    (($# == 1)) || { printf 'Usage: proxycode check\n' >&2; exit 2; }
    proxycode_with_lifecycle_lock proxycode_check_locked
    ;;
  switch)
    (($# == 2 || $# == 3)) || { printf 'Usage: proxycode switch NAME [--yes]\n' >&2; exit 2; }
    yes=false
    if (($# == 3)); then
      [[ $3 == --yes ]] || { printf "proxycode switch: unknown option '%s'\n" "$3" >&2; exit 2; }
      yes=true
    fi
    proxycode_with_lifecycle_lock proxycode_switch_locked "$2" "$yes"
    ;;
  profile)
    shift
    case ${1:-} in
      list)
        (($# == 1)) || { printf 'proxycode profile list: unexpected arguments\n' >&2; exit 2; }
        proxycode_profile_list
        ;;
      show)
        (($# == 2)) || { printf 'Usage: proxycode profile show NAME\n' >&2; exit 2; }
        proxycode_profile_show "$2"
        ;;
      import)
        (($# >= 2)) || { printf 'Usage: proxycode profile import FILE --name NAME [--default] [--replace] [--yes]\n' >&2; exit 2; }
        source_file=$2
        name=
        make_default=false
        replace=false
        yes=false
        shift 2
        while (($#)); do
          case $1 in
            --name)
              (($# >= 2)) || { printf 'proxycode profile import: --name requires a value\n' >&2; exit 2; }
              name=$2
              shift
              ;;
            --default) make_default=true ;;
            --replace) replace=true ;;
            --yes) yes=true ;;
            *) printf "proxycode profile import: unknown option '%s'\n" "$1" >&2; exit 2 ;;
          esac
          shift
        done
        [[ -n $name ]] || { printf 'proxycode profile import: --name is required\n' >&2; exit 2; }
        proxycode_with_lifecycle_lock proxycode_profile_import "$source_file" "$name" "$make_default" "$replace" "$yes"
        ;;
      default)
        (($# == 2)) || { printf 'Usage: proxycode profile default NAME\n' >&2; exit 2; }
        proxycode_profile_default "$2"
        ;;
      remove)
        (($# == 2 || $# == 3)) || { printf 'Usage: proxycode profile remove NAME [--yes]\n' >&2; exit 2; }
        yes=false
        if (($# == 3)); then
          [[ $3 == --yes ]] || { printf "proxycode profile remove: unknown option '%s'\n" "$3" >&2; exit 2; }
          yes=true
        fi
        proxycode_with_lifecycle_lock proxycode_profile_remove "$2" "$yes"
        ;;
      settings)
        (($# >= 2)) || { printf 'Usage: proxycode profile settings NAME [PROBE OPTIONS]\n' >&2; exit 2; }
        name=$2
        shift 2
        if (($# == 0)); then
          proxycode_profile_settings_show "$name"
          exit
        fi
        probe= expectation= url= status= contains=
        while (($#)); do
          case $1 in
            --probe|--expect-location|--url|--status|--contains)
              (($# >= 2)) || { printf "proxycode profile settings: %s requires a value\n" "$1" >&2; exit 2; }
              case $1 in
                --probe) probe=$2 ;;
                --expect-location) expectation=$2 ;;
                --url) url=$2 ;;
                --status) status=$2 ;;
                --contains) contains=$2 ;;
              esac
              shift
              ;;
            *) printf "proxycode profile settings: unknown option '%s'\n" "$1" >&2; exit 2 ;;
          esac
          shift
        done
        [[ -n $probe ]] || { printf 'proxycode profile settings: --probe is required when changing settings\n' >&2; exit 2; }
        proxycode_profile_settings_update "$name" "$probe" "$expectation" "$url" "$status" "$contains"
        ;;
      *) printf 'Usage: proxycode profile list|show|import|default|remove|settings ...\n' >&2; exit 2 ;;
    esac
    ;;
  settings)
    shift
    if (($# == 0)); then
      proxycode_settings_show
      exit
    fi
    http_port=
    while (($#)); do
      case $1 in
        --http-port)
          (($# >= 2)) || { printf "proxycode settings: %s requires a value\n" "$1" >&2; exit 2; }
          http_port=$2
          shift
          ;;
        *) printf "proxycode settings: unknown option '%s'\n" "$1" >&2; exit 2 ;;
      esac
      shift
    done
    proxycode_with_lifecycle_lock proxycode_settings_update "$http_port"
    ;;
  upgrade)
    printf 'proxycode: upgrade is not available yet\n' >&2
    exit 2
    ;;
  '')
    interactive_management
    ;;
  *)
    [[ $1 != -* ]] || { printf "proxycode: unknown option '%s'\n" "$1" >&2; exit 2; }
    proxycode_with_lifecycle_lock proxycode_prepare_wrapped_command_locked "$selected_profile" || exit
    export HTTP_PROXY=$PROXYCODE_WRAPPED_PROXY http_proxy=$PROXYCODE_WRAPPED_PROXY
    export HTTPS_PROXY=$PROXYCODE_WRAPPED_PROXY https_proxy=$PROXYCODE_WRAPPED_PROXY
    export ALL_PROXY=$PROXYCODE_WRAPPED_PROXY all_proxy=$PROXYCODE_WRAPPED_PROXY
    export NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1
    exec "$@"
    ;;
esac
